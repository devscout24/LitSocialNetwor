{
  "name": "Lit-SocialNetwor",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.5",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "@types/react": "~19.2.18",
      "@types/react-dom": "~19.2.3",
      "vitest": "4.1.8",
      "@vitest/ui": "4.1.8",
      "@vitest/coverage-v8": "4.1.8",
      "jsdom": "^29.1.1",
      "@playwright/test": "^1.63.0",
      "playwright": "^1.63.0",
      "tailwindcss": "^4.3.3",
      "@supabase/supabase-js": "^2.49.1",
      "react-native-url-polyfill": "^2.0.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:native": "turbo -F native dev",
    "dev:dashboard": "turbo -F dashboard dev",
    "db:types": "echo 'To regenerate types from your self-hosted VPS Supabase instance, set SUPABASE_DB_URL and run: bunx supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" > packages/supabase/src/types.ts'",
    "test": "bun run --filter web test && bun run --filter native test",
    "lint:eslint": "eslint .",
    "format:prettier": "prettier --write .",
    "format:prettier:check": "prettier --check ."
  },
  "dependencies": {
    "@Lit-SocialNetwor/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Lit-SocialNetwor/config": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/bun": "catalog:",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "2.10.11",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "bun@1.4.4"
}
