# Self-hosted VPS Supabase instance URL and anon/publishable key
EXPO_PUBLIC_SUPABASE_URL=https://supabase.your-vps-domain.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Mobile auth callback path used with expo-linking (lit-socialnetwor://auth/callback)
EXPO_PUBLIC_AUTH_REDIRECT_PATH=auth/callback
# EAS project ID for Expo push notification tokens
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
