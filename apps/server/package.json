{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@Lit-SocialNetwor/api": "workspace:*",
    "@Lit-SocialNetwor/auth": "workspace:*",
    "@Lit-SocialNetwor/db": "workspace:*",
    "@Lit-SocialNetwor/env": "workspace:*",
    "@arcjet/node": "^1.14.0",
    "@elastic/elasticsearch": "^9.5.1",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "catalog:",
    "better-auth": "catalog:",
    "bullmq": "^5.81.2",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "ioredis": "^5.11.1",
    "resend": "^6.32.0",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Lit-SocialNetwor/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
